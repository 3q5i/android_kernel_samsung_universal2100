#include <dt-bindings/soc/samsung/exynos-bts.h>

/ {
	exynos_bts: exynos-bts {
		compatible = "samsung,exynos-bts";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;
		list-scen = "default", "cp_throughput",
				"mfc_uhd", "mfc_uhd_10bit",
				"mfc_8k_dec30", "g3d_heavy",
				"g3d_gamesdk", "g3d_performance",
				"dp_default", "camera_default",
				"npu_normal", "mfc_uhd_enc60",
				"camera_heavy", "npu_performance";

		bts_irp0 {
			#address-cells = <2>;
			#size-cells = <1>;
			ranges;
			reg = <0x00 0x1a8a4000 0x400>;
			status = "okay";
			bts-type = <TREX_BTS>;
		};

		bts_irp1 {
			reg = <0x00 0x1a8b4000 0x400>;
			status = "okay";
			bts-type = <TREX_BTS>;
		};

