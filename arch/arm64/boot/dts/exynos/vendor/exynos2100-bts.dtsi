		bts_csis0 {
			reg = <0x00 0x1b600000 0x100>;
			status = "okay";
			bts-type = <IP_BTS>;

			default {
				stat_on = <1>;
				bypass = <0>;
				arqos = <0x0c>;
				awqos = <0x0c>;
				rmo = <0xffff>;
				wmo = <0x40>;
