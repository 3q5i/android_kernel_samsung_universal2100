	exynos_dsufreq: exynos-dsufreq {
		compatible = "samsung,exynos-dsufreq";
		status = "okay";
		cal-id = <ACPM_DVFS_DSU>;
		dm-type = <DM_DSU>;
		dss-type = <ESS_FLAG_DSU>;
		init-with-dt = <1>;

		request_domain0 {
			sibling-cpus = "0-3";
			constraint = <&lit_dsu_perf>;
		};

		request_domain1 {
			sibling-cpus = "4-6";
			constraint = <&med_dsu_perf>;
		};

		request_domain2 {
			sibling-cpus = "7";
			constraint = <&big_dsu_perf>;
		};
	};

	exynos_ufcc: exynos-ufcc {
		compatible = "samsung,exynos-ufcc";
		status = "okay";

		ucc {
			ucc-config0 {
				index = <0>;
				cstate = "4-7";
			};
			ucc-config1 {
				index = <1>;
				cstate = "7";
			};
			ucc-config2 {
				index = <2>;
			};
		};

		ufc {
			table-col = <6>;
			boot-domain-auto-table;
			domain@0 {
				device_type = "ufc-domain";
				shared-cpus = "0-3";
				table-col-idx = <3>;
			};
			domain@1 {
				device_type = "ufc-domain";
				shared-cpus = "4-6";
				table-col-idx = <2>;
				allow-disable-cpus;
			};
			domain@2 {
				device_type = "ufc-domain";
				shared-cpus = "7";
				table-col-idx = <1>;
				allow-disable-cpus;
			};

			max-limit {
				device_type = "ufc-table";
				ctrl-type = <0x02>;
				table = <
				/* VFREQ     BIG(P)   MED      LIT  EMS STRICT */
				2912000  2912000  2808000  2210000  0    0
				2808000  2808000  2808000  1898000  0    0
