#include <dt-bindings/soc/samsung/cpupm.h>

/ {
	cpus: cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 { cpu = <&cpu0>; };
				core1 { cpu = <&cpu1>; };
				core2 { cpu = <&cpu2>; };
				core3 { cpu = <&cpu3>; };
			};

			cluster1 {
				core0 { cpu = <&cpu4>; };
				core1 { cpu = <&cpu5>; };
				core2 { cpu = <&cpu6>;};
			};

			cluster2 {
				core0 { cpu = <&cpu7>; };
			};
		};

		cpu0: cpu@0000 {
			device_type = "cpu";
			compatible = "arm,ananke", "arm,armv8";
			reg = <0x00 0x00>;
			capacity-dmips-mhz = <260>;
			dynamic-power-coefficient = <89>;
			enable-method = "psci";
			cpu-idle-states = <&ANANKE_CPU_SLEEP>;
			sched-energy-data = <&ANANKE_ENERGY>;
		};

		cpu1: cpu@0100 {
			device_type = "cpu";
			compatible = "arm,ananke", "arm,armv8";
			reg = <0x00 0x100>;
			capacity-dmips-mhz = <260>;
			dynamic-power-coefficient = <89>;
			enable-method = "psci";
			cpu-idle-states = <&ANANKE_CPU_SLEEP>;
			sched-energy-data = <&ANANKE_ENERGY>;
		};

		cpu2: cpu@0200 {
			device_type = "cpu";
			compatible = "arm,ananke", "arm,armv8";
			reg = <0x00 0x200>;
			capacity-dmips-mhz = <260>;
			dynamic-power-coefficient = <89>;
			enable-method = "psci";
			cpu-idle-states = <&ANANKE_CPU_SLEEP>;
			sched-energy-data = <&ANANKE_ENERGY>;
		};

		cpu3: cpu@0300 {
			device_type = "cpu";
			compatible = "arm,ananke", "arm,armv8";
			reg = <0x00 0x300>;
			capacity-dmips-mhz = <260>;
			dynamic-power-coefficient = <89>;
			enable-method = "psci";
			cpu-idle-states = <&ANANKE_CPU_SLEEP>;
			sched-energy-data = <&ANANKE_ENERGY>;
		};

		cpu4: cpu@0400 {
			device_type = "cpu";
			compatible = "arm,hercules", "arm,armv8";
			reg = <0x00 0x400>;
			capacity-dmips-mhz = <880>;
			dynamic-power-coefficient = <513>;
			enable-method = "psci";
			cpu-idle-states = <&HERCULES_CPU_SLEEP>;
			sched-energy-data = <&HERCULES_ENERGY>;
		};

		cpu5: cpu@0500 {
			device_type = "cpu";
			compatible = "arm,hercules", "arm,armv8";
			reg = <0x00 0x500>;
			capacity-dmips-mhz = <880>;
			dynamic-power-coefficient = <513>;
			enable-method = "psci";
			cpu-idle-states = <&HERCULES_CPU_SLEEP>;
			sched-energy-data = <&HERCULES_ENERGY>;
		};

		cpu6: cpu@0600 {
			device_type = "cpu";
			compatible = "arm,hercules", "arm,armv8";
			reg = <0x00 0x600>;
			capacity-dmips-mhz = <880>;
			dynamic-power-coefficient = <513>;
			enable-method = "psci";
			cpu-idle-states = <&HERCULES_CPU_SLEEP>;
			sched-energy-data = <&HERCULES_ENERGY>;
		};

		cpu7: cpu@0700 {
			device_type = "cpu";
			compatible = "arm,hera", "arm,armv8";
			reg = <0x00 0x700>;
			capacity-dmips-mhz = <997>;
			dynamic-power-coefficient = <757>;
			enable-method = "psci";
			cpu-idle-states = <&HERA_CPU_SLEEP>;
			sched-energy-data = <&HERA_ENERGY>;
		};

		idle-states {
			entry-method = "arm,psci";
			ANANKE_CPU_SLEEP: ananke-cpu-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <70>;
				exit-latency-us = <160>;
				min-residency-us = <2000>;
				status = "okay";
			};
			HERCULES_CPU_SLEEP: hercules-cpu-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <150>;
				exit-latency-us = <190>;
				min-residency-us = <2500>;
				status = "okay";
			};
			HERA_CPU_SLEEP: hera-cpu-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <235>;
				exit-latency-us = <220>;
				min-residency-us = <3500>;
				status = "okay";
			};
		};

		energy-data {
			ANANKE_ENERGY: ananke-energy {
				mips-per-mhz = <260>;
				power-coefficient = <89>;
				static-power-coefficient = <87>;
				static-power-coefficient-2nd = <20>;
			};
			HERCULES_ENERGY: hercules-energy {
				mips-per-mhz = <880>;
				power-coefficient = <513>;
				static-power-coefficient = <253>;
			};
			HERA_ENERGY: hera-energy {
				mips-per-mhz = <997>;
				power-coefficient = <757>;
				static-power-coefficient = <313>;
			};
		};
	};

	psci: psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	exynos_cpuhp: exynos-cpuhp {
		compatible = "samsung,exynos-cpuhp";
		status = "okay";
	};

	exynos_cpupm: exynos-cpupm {
		compatible = "samsung,exynos-cpupm";
		status = "okay";

		cpd_cl0 {
			device_type = "cpupm";
			target-residency = <10000>;
			type = <POWERMODE_TYPE_CLUSTER>;
			cal-id = <NONE>;
			siblings = "0-3";
		};

		cpd_cl1 {
			device_type = "cpupm";
			target-residency = <10000>;
			type = <POWERMODE_TYPE_CLUSTER>;
			cal-id = <1>;
			siblings = "4-6";
			entry-allowed = "4-6";
		};

		cpd_cl2 {
			device_type = "cpupm";
			target-residency = <10000>;
			type = <POWERMODE_TYPE_CLUSTER>;
			cal-id = <2>;
			siblings = "7";
			entry-allowed = "7";
		};

		dsupd {
			device_type = "cpupm";
			target-residency = <10000>;
			type = <POWERMODE_TYPE_DSU>;
			siblings = "0-7";
			entry-allowed = "0-7";
		};

		sicd {
			device_type = "cpupm";
			target-residency = <10000>;
			type = <POWERMODE_TYPE_SYSTEM>;
			siblings = "0-7";
			entry-allowed = "0-7";
		};

		wakeup-mask {
			wakeup-masks {
				wakeup-mask {
					mask-reg-offset = <0x3b44>;
					stat-reg-offset = <0x3b50>;
					mask = <0xff000000>;
				};
				wakeup-mask2 {
					mask-reg-offset = <0x3b64>;
					stat-reg-offset = <0x3b54>;
					mask = <0x00>;
				};
			};

			eint-wakeup-masks {
				eint-wakeup-mask {
					mask-reg-offset = <0x60c>;
				};
				eint-wakeup-mask2 {
					mask-reg-offset = <0x610>;
				};
			};
		};
	};

	exynos_acme: exynos-acme {
		compatible = "samsung,exynos-acme";
		status = "okay";

		cpufreq_domain0: domain@0 {
			sibling-cpus = "0-3";
			cal-id = <ACPM_DVFS_CPUCL0>;
			dm-type = <DM_CPU_CL0>;
			max-freq = <2210000>;
			min-freq = <400000>;
			#cooling-cells = <2>;
			ect-coeff-index = <2>;
			tz-cooling-name = "LITTLE";
			freq-table = <
				177000 266000
				400000 533000
				650000 754000
				858000 962000
				1066000 1170000
				1274000 1378000
				1482000 1586000
				1690000 1794000
				1898000 2002000
				2106000 2210000
				2314000 2392000>;

			dm-constraints {
				list = <&lit_dsu_perf>, <&lit_mif_perf>;
			};
		};

		cpufreq_domain1: domain@1 {
			sibling-cpus = "4-6";
			cal-id = <ACPM_DVFS_CPUCL1>;
			dm-type = <DM_CPU_CL1>;
			max-freq = <2808000>;
			min-freq = <533000>;
			#cooling-cells = <2>;
			ect-coeff-index = <1>;
			tz-cooling-name = "MID";
			freq-table = <
				177000 266000
				400000 533000
				624000 728000
				832000 936000
				1040000 1144000
				1248000 1352000
				1456000 1560000
				1664000 1768000
				1872000 1976000
				2080000 2184000
				2288000 2392000
				2496000 2600000
				2704000 2808000
				2912000 2990000>;

			dm-constraints {
				list = <&med_dsu_perf>, <&med_mif_perf>;
			};
		};

		cpufreq_domain2: domain@2 {
			sibling-cpus = "7";
			cal-id = <ACPM_DVFS_CPUCL2>;
			dm-type = <DM_CPU_CL2>;
			max-freq = <2912000>;
			min-freq = <533000>;
			#cooling-cells = <2>;
			ect-coeff-index = <0>;
			tz-cooling-name = "BIG";
			freq-table = <
				177000 266000
				400000 533000
				624000 728000
				832000 936000
				1040000 1144000
				1248000 1352000
				1456000 1560000
				1664000 1768000
				1872000 1976000
				2080000 2184000
				2288000 2392000
				2496000 2600000
				2704000 2808000
				2912000 2990000>;

			dm-constraints {
				list = <&big_dsu_perf>, <&big_mif_perf>;
			};
		};
	};

