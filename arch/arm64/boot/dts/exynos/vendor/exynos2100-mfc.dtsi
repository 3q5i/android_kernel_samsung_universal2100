			votf_start_offset = <0xf000>;
			votf_end_offset = <0x10000>;
			num_default_qos_steps = <9>;
			num_encoder_qos_steps = <8>;
			max_mb = <5315425>;
			max_hw_mb = <3888000>;
			mfc_freq_control = <1>;
			mo_control = <1>;
			bw_control = <1>;
			#dma-address-cells = <1>;
			#dma-size-cells = <1>;
			dma-window = <0x00 0xd0000000>;
			#address-cells = <2>;
			#size-cells = <1>;
			ranges;

			iommu { reg = <0x00 0x18670000 0x9000 0x00 0x186a0000 0x9000>; };
			hwfc { reg = <0x00 0x19cba164 0x04>; };
			camerapp_votf: votf { reg = <0x00 0x18700000 0x1000>; };

			/* Default QoS table */
			mfc_default_qos_table {
