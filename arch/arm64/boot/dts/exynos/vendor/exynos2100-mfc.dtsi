		mfc_core0: MFC-0 {
			compatible = "samsung,exynos-mfc-core";
			id = <0x00>;
			reg = <0x00 0x186d0000 0x10000>;
			interrupts = <GIC_SPI INTREQ__MFC0 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "aclk_mfc";
			clocks = <&clock UMUX_CLKCMU_MFC0_MFC0>;
			iommus = <&sysmmu_d0_mfc0>, <&sysmmu_d1_mfc0>;
			samsung,iommu-group = <&iommu_group_mfc>;
			samsung,tzmp;
			samsung,imgloader-s2mpu-support;

			/* MFC version */
			ip_ver = <0x1500010c>;

			/* Sysmmu check */
			share_sysmmu = <0>;
			axid_mask = <0xffff>;
			mfc_fault_num = <0x00>;
			trans_info_offset = <0x1004>;

			/* LLC (Last Level Cache) */
