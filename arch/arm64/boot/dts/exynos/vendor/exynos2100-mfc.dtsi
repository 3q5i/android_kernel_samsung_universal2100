#include <dt-bindings/clock/exynos2100.h>
#include <dt-bindings/soc/samsung/exynos_pm_qos.h>

/ {
	mfc: mfc {
		compatible = "samsung,exynos-mfc";
		iommus = <&sysmmu_d0_mfc0>, <&sysmmu_d1_mfc0>,
				<&sysmmu_d0_mfc1>, <&sysmmu_d1_mfc1>;
		samsung,iommu-group = <&iommu_group_mfc>;
		samsung,tzmp;

		/* MFC version */
		ip_ver = <0x1500010c>;
		debug_mode = <0>;
		nal_q_entry_size = <768>;
		nal_q_dump_size = <376>;
		nal_q = <0x01 0x00>;
		skype = <0x01 0x00>;
		black_bar = <0x01 0x00>;
		color_aspect_dec = <0x01 0x00>;
		static_info_dec = <0x01 0x00>;
		color_aspect_enc = <0x01 0x00>;
		static_info_enc = <0x01 0x180314>;
		hdr10_plus = <0x01 0x180709>;
		vp9_stride_align = <0x01 0x00>;
		sbwc_uncomp = <0x01 0x190702>;
		mem_clear = <0x01 0x00>;
		wait_fw_status = <0x01 0x190122>;
		wait_nalq_status = <0x01 0x191107>;
		drm_switch_predict = <0x01 0x00>;
		sbwc_enc_src_ctrl = <0x01 0x200110>;
