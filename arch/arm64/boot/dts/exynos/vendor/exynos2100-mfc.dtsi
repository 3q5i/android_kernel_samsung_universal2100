		min_quality_mode = <0x01 0x210713>;
		support_av1_dec = <1>;
		av1_film_grain = <0x01 0x200717>;
		P010_decoding = <1>;
		dithering_enable = <0>;
		enc_ts_delta = <0x01 0x211015>;
		support_10bit = <1>;
		support_422 = <1>;
		support_rgb = <1>;
		support_sbwc = <1>;
		support_sbwcl = <1>;
		sbwc_dec_max_width = <1920>;
		sbwc_dec_max_height = <1088>;
		sbwc_dec_max_inst_num = <1>;
		max_hdr_win = <1>;
		display_err_type = <2>;
		display_framerate = <0>;
		enc_param_num = <25>;

		/* Encoder default parameter: max number is 100 */
		enc_param_addr = <
				0xf7b4 0xf7b8 0xf7b0 0xf798 0xfa2c
				0xf790 0xfa34 0xfa38 0xfa3c 0xf7c0
				0xf7c8 0xf7cc 0xfa60 0xfdd4 0xfddc
