			<0x01 0x80 0x04 0xffff 0x01>,
			<0x01 0x80 0x8000 0xffff 0x01>,
			<0x01 0x80 0x08 0xffff 0x01>,
			<0x01 0x80 0x200 0xffff 0x01>,
			<0x01 0x80 0x100 0xffff 0x01>,
			<0x01 0x80 0x10 0xffff 0x01>,
			<0x01 0x80 0x01 0xffff 0x01>,
			<0x01 0x80 0x8000 0xffff 0x01>,
			<0x01 0x80 0x4000 0xffff 0x01>;
		samsung,imgloader-s2mpu-support = "true";
		samsung,npusched-tpf-others = <0x5dc>;
		samsung,npusched-afmlimit = <0xc3500>;
		samsung,npusched-min-active-cores = <0x01>;
		samsung,npusched-dvfs =
