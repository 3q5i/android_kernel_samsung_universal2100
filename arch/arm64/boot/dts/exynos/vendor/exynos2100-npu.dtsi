			<0x03 0x708 0x50000000 0xffffffff 0x00>,
			<0x03 0x700 0x01 0xffffffff 0x00>,
			<0x01 0x00 0x01 0xffffffff 0x00>;
		samsung,npucmd-cpuoff-sfr = "sfrnpus", "sfrnpu0", "sfrnpu1", "sfrnpu2", "sfrnpus", "sfrpmu";
		samsung,npucmd-cpuoff-data =
			<0x01 0x800 0xf1000000 0xf1000000 0x00>,
			<0x01 0x800 0xf1000000 0xf1000000 0x00>,
			<0x01 0x800 0xf1000000 0xf1000000 0x00>,
			<0x01 0x800 0xf1000000 0xf1000000 0x00>,
			<0x01 0x20414 0x1800 0x1800 0x00>,
			<0x01 0x00 0x00 0xffffffff 0x00>;
		samsung,npucmd-hwacgen-sfr = "sfrnpus", "sfrnpu0", "sfrnpu1", "sfrnpu2";
		samsung,npucmd-hwacgen-data =
			<0x01 0x800 0xf1000000 0xf1000000 0x00>,
			<0x01 0x800 0xf1000000 0xf1000000 0x00>,
			<0x01 0x800 0xf1000000 0xf1000000 0x00>,
			<0x01 0x800 0xf1000000 0xf1000000 0x00>;
		samsung,npucmd-hwacgdis-sfr = "sfrnpus", "sfrnpu0", "sfrnpu1", "sfrnpu2";
		samsung,npucmd-hwacgdis-data =
			<0x01 0x800 0x00 0xf1000000 0x00>,
			<0x01 0x800 0x00 0xf1000000 0x00>,
			<0x01 0x800 0x00 0xf1000000 0x00>,
			<0x01 0x800 0x00 0xf1000000 0x00>;
		samsung,npucmd-glafmen-sfr = "htunpus", "htunpus";
		samsung,npucmd-glafmen-data =
			<0x01 0x200 0x80000000 0x80000000 0x00>,
			<0x01 0x00 0x01 0x01 0x00>;
		samsung,npucmd-glafmdis-sfr = "htunpus", "htunpus";
		samsung,npucmd-glafmdis-data =
			<0x01 0x200 0x00 0x80000000 0x00>,
			<0x01 0x00 0x00 0x01 0x00>;
		samsung,npucmd-afmitren-sfr = "htunpus", "htunpus", "htunpus", "htunpus", "htunpus", "htunpus";
		samsung,npucmd-afmitren-data =
			<0x01 0x80 0x800000 0xfff00000 0x00>,
			<0x01 0x80 0x00 0xfff0 0x00>,
			<0x01 0x80 0x02 0x02 0x00>,
			<0x01 0x80 0x01 0x01 0x00>,
			<0x01 0x48 0x3f000000 0x3f000000 0x00>,
			<0x01 0x6c 0x08 0xf8 0x00>;
