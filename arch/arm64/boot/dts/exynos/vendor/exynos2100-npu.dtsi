			<0x00 0x00 0x00 0xffffffff 0x00>,
			<0x00 0x6c 0x00 0xffffffff 0x00>,
			<0x00 0x80 0x00 0xffffffff 0x00>;
		samsung,npucmd-cpupc-sfr = "sfrsnpus";
		samsung,npucmd-cpupc-data = <0x02 0x50c 0x00 0xffffffff 0x00>;
		samsung,npucmd-buspdiv1to1-sfr = "sfrnpu0", "sfrnpu1", "sfrnpu2";
		samsung,npucmd-buspdiv1to1-data =
			<0x01 0x1800 0x00 0x0f 0x00>,
			<0x01 0x1800 0x00 0x0f 0x00>,
			<0x01 0x1800 0x00 0x0f 0x00>;
		samsung,npucmd-buspdiv1to4-sfr = "sfrnpu0", "sfrnpu1", "sfrnpu2";
		samsung,npucmd-buspdiv1to4-data =
			<0x01 0x1800 0x03 0x0f 0x00>,
			<0x01 0x1800 0x03 0x0f 0x00>,
			<0x01 0x1800 0x03 0x0f 0x00>;
		samsung,npucmd-enablestm-sfr = "sfrsnpus", "sfrnpuc0", "sfrnpuc1", "sfrnpuc2", "sfrcoresight", "sfrcoresight";
		samsung,npucmd-enablestm-data =
			<0x03 0x508 0x01 0x01 0x00>,
			<0x01 0x20514 0x01 0x01 0x00>,
			<0x01 0x20514 0x01 0x01 0x00>,
			<0x01 0x20514 0x01 0x01 0x00>,
			<0x01 0x34 0x01 0x07 0x00>,
			<0x01 0x2c 0x01 0x01 0x00>;
		samsung,npucmd-disablestm-sfr = "sfrcoresight", "sfrnpuc0", "sfrnpuc1", "sfrnpuc2", "sfrsnpus";
		samsung,npucmd-disablestm-data =
			<0x01 0x34 0x00 0x07 0x00>,
