	npuc0: npu_core0 {
		compatible = "samsung,exynos-npu-core";
		samsung,npucore-id = <0>;
		status = "ok";
	};

	npuc1: npu_core1 {
		compatible = "samsung,exynos-npu-core";
		samsung,npucore-id = <1>;
		status = "ok";
	};
};
