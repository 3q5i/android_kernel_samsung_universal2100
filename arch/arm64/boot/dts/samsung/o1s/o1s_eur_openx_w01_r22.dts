/ {
	fragment@sec_debug_data {
		target-path = "/";
		compatible = "sec_debug_data";
		__overlay__ {
			sec_debug_data {
				kallsyms {
					_stext = <0xffffffc0 0x10081000>;
					_etext = <0xffffffc0 0x10f50000>;
					kallsyms_offsets = <0xffffffc0 0x11341df0>;
					kallsyms_relative_base = <0xffffffc0 0x113c2ab8>;
					kallsyms_num_syms = <0xffffffc0 0x113c2ac0>;
					kallsyms_names = <0xffffffc0 0x113c2ac8>;
					kallsyms_markers = <0xffffffc0 0x11680eb8>;
					kallsyms_token_table = <0xffffffc0 0x116816c8>;
					kallsyms_token_index = <0xffffffc0 0x11681a20>;
					_sinittext = <0xffffffc0 0x11a20000>;
					_einittext = <0xffffffc0 0x11a9dd14>;
					_end = <0xffffffc0 0x120e8000>;
				};
				kconstants {
					swapper_pg_dir = <0xffffffc0 0x11a11000>;
				};
			};
		};
	};
};

/ {
	fragment@sec_debug {
		target-path = "/";
		__overlay__ {
			sec_debug {
				compatible = "samsung,sec_debug";
				status = "okay";
				memory-region = <&sec_debug_next &ram_base>;
			};
		};
	};
};

/ {
	fragment@sec_debug_built {
		target-path = "/";
		__overlay__ {
			sec_debug_built {
				compatible = "samsung,sec_debug_built";
				status = "okay";
				memory-region = <&sec_debug_next>;
			};
		};
	};
};

&reserved_memory {
	sec_debug_next: sec_debug_next {
		reg = <0x00 0x91200000 0x1000000>;
		no-map;
	};
	ram_base: ram_base {
		reg = <0x00 0x80000000 0x1000>;
		no-map;
	};
};

/ {
	fragment@common {
		target-path = "/";
		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			argos {
				compatible = "samsung,argos";
				#address-cells = <0x01>;
				boot_device@1 {
					net_boost,label = "UFS";
					net_boost,node = [00];
					net_boost,sysnode = "/sys/class/sec/ufs/transferred_cnt";
					net_boost,interval = <0x01>;
					net_boost,table {
						level_0 {
							threshold = <0x190>;
							big_min = <0x261600>;
							mid_min = <0x261600>;
							lit_min = <0x1cf610>;
							int = "", "\f5";
							mif = <0x14a140>;
						};
					};
				};
				boot_device@2 {
					net_boost,label = "P2P";
					net_boost,node = "p2p-wlan0-0";
					net_boost,slowdown;
					net_boost,table {
						level_0 {
							threshold = <0x3c>;
							mid_min = <0x163780>;
							lit_min = <0x163780>;
						};
						level_1 {
							threshold = <0x96>;
							mid_min = <0x19c990>;
							lit_min = <0x1a94b0>;
						};
						level_2 {
							threshold = <0xc8>;
							mid_min = <0x1cf610>;
							lit_min = <0x1a94b0>;
							mif = <0x14a140>;
							int = <0x61a80>;
							task_affinity = "enable";
							irq_affinity = "enable";
							hmp_boost = "enable";
						};
						level_3 {
							threshold = <0x12c>;
							mid_min = <0x202290>;
							lit_min = <0x1a94b0>;
							mif = <0x1a2f20>;
							int = <0x82208>;
							task_affinity = "enable";
							irq_affinity = "enable";
							hmp_boost = "enable";
						};
					};
				};
				boot_device@3 {
					net_boost,label = "NAN";
					net_boost,node = "aware_data0";
					net_boost,slowdown;
					net_boost,table {
						level_0 {
							threshold = <0x3c>;
							mid_min = <0x163780>;
							lit_min = <0x163780>;
						};
						level_1 {
							threshold = <0x96>;
							mid_min = <0x19c990>;
							lit_min = <0x1a94b0>;
						};
						level_2 {
							threshold = <0xc8>;
							mid_min = <0x1cf610>;
							lit_min = <0x1a94b0>;
							mif = <0x14a140>;
							int = <0x61a80>;
							task_affinity = "enable";
							irq_affinity = "enable";
							hmp_boost = "enable";
						};
						level_3 {
							threshold = <0x12c>;
							mid_min = <0x202290>;
							lit_min = <0x1a94b0>;
							mif = <0x1a2f20>;
							int = <0x82208>;
							task_affinity = "enable";
							irq_affinity = "enable";
							hmp_boost = "enable";
						};
					};
				};
			};
		};
	};
};

&pinctrl_2 {
	grip_int: grip-int {
		samsung,pins = "gpa3-0";
		samsung,pin-function = <0x0f>;
		samsung,pin-pud = <0x00>;
	};
};

&pinctrl_6 {
	grip_i2c: grip-i2c {
		samsung,pins = "gpp6-2", "gpp6-3";
		samsung,pin-function = <0x03>;
		samsung,pin-pud = <0x00>;
		samsung,pin-con-pdn = <0x03>;
		samsung,pin-pud-pdn = <0x00>;
	};
};

&hsi2c_13 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	status = "okay";
	clock-frequency = <0x61a80>;
	samsung,reset-before-trans;
	pinctrl-names = "default";
	pinctrl-0 = <&grip_i2c>;
	isg5320a@28 {
		compatible = "isg5320a";
		pinctrl-names = "default";
		pinctrl-0 = <&grip_int>;
		reg = <0x28>;
		status = "okay";
		interrupt-parent = <&gpa3>;
		interrupts = <0x00 0x00 0x00>;
		isg5320a,irq-gpio = <&gpa3 0x00 0x00>;
		isg5320a,hallic_detect = <0x01>;
		isg5320a,hallic_cert_detect = <0x01>;
	};
};

/ {
	fragment@sec_wakeup_cpu_allocator {
		target-path = "/";
		__overlay__ {
			sec_wakeup_cpu_allocator {
				compatible = "samsung,sec_wakeup_cpu_allocator";
				start_cpu_num = <0x04>;
				end_cpu_num = <0x06>;
			};
		};
	};
};

&camera_heap {
	size = "1 ", "";
};

&udc {
	status = "okay";
	dr_mode = "otg";
	maximum-speed = "super-speed";
	snps,quirk-frame-length-adjustment = <0x20>;
	snps,u1u2_exitfail_quirk;
	snps,ux_exit_in_px_quirk;
	snps,elastic_buf_mode_quirk;
	snps,dis-u2-freeclk-exists-quirk;
	usb_audio_offloading = <0x01>;
	abox = <&abox>;
	xhci_l2_support = <0x00>;
	xhci_use_uram_for_audio = <0x01>;
	samsung,no-extra-delay;
	samsung,force-gen1;
	vdd085_usb-supply = <&l10_reg>;
	vdd18_usb-supply = <&l12_reg>;
	vdd33_usb-supply = <&s_l6_reg>;
};

&usbdrd_phy0 {
	status = "okay";
	use_default_tune_val = <0x01>;
	pinctrl-names = "default";
	phy,gpio_phy_port = <&gpm17 0x00 0x00>;
	hs_tune_param = <&usb_hs_tune>;
	ss_tune_param = <&usb_ss_tune>;
	vdd085_usb-supply = <&l10_reg>;
	vdd18_usb-supply = <&l12_reg>;
	vdd33_usb-supply = <&s_l6_reg>;
};

&chosen {
	bootargs_ext = "androidboot.boot_devices=13100000.ufs coherent_pool=8M";
};

&serial_0 {
	status = "okay";
};

&serial_1 {
	samsung,rts-trig-level = <0x01>;
	samsung,rts-gpio-control;
	samsung,uart-logging;
	samsung,uart-panic-log;
	status = "okay";
};

&pinctrl_2 {
	key_voldown: key-voldown {
		samsung,pins = "gpa0-4";
		samsung,pin-function = <0x0f>;
		samsung,pin-pud = <0x00>;
		samsung,pin-drv = <0x03>;
	};
	key_volup: key-volup {
		samsung,pins = "gpa0-3";
		samsung,pin-function = <0x0f>;
		samsung,pin-pud = <0x00>;
		samsung,pin-drv = <0x03>;
	};
	dwmmc2_cd_ext_irq: dwmmc2_cd_ext_irq {
		samsung,pins = "gpa1-5";
		samsung,pin-function = <0x0f>;
		samsung,pin-pud = <0x03>;
		samsung,pin-drv = <0x04>;
	};
	wlan_host_wake: wlan_host_wake {
		samsung,pins = "gpa0-7";
		samsung,pin-function = <0x0f>;
		samsung,pin-pud = <0x01>;
	};
};

&pcie_0 {
	pinctrl-names = "active", "idle";
	pinctrl-0 = <&pcie0_clkreq &pcie0_perst &cfg_wlanen &wlan_host_wake>;
	pinctrl-1 = <&pcie0_perst &cfg_wlanen &wlan_host_wake>;
	status = "okay";
	use-sysmmu = "false";
	use-cache-coherency = "false";
	use-msi = "false";
	ep-device-type = <0x01>;
	pcie,wlan-gpio = <&gpp12 0x02 0x01>;
	ep-device-name = "WIFI";
};

&ufs {
	brd-for-cal = [10];
};

&fmp_0 {
	exynos,block-type = "sda";
	exynos,fips-block_offset = <0x05>;
};

&dwmmc_2 {
	#address-cells = <0x02>;
	#size-cells = <0x01>;
	status = "disabled";
	num-slots = <0x01>;
	supports-4bit;
	supports-cmd23;
	supports-erase;
	supports-highspeed;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	card-detect-gpio;
	bypass-for-allpass;
	use-fine-tuning;
	card-init-hwacg-ctrl;
	skip-init-mmc-scan;
	ssc-rate = <0x03>;
	fifo-depth = <0x40>;
	qos_dvfs_level = <0x61a80>;
	desc-size = <0x04>;
	card-detect-delay = <0xc8>;
	data-timeout = <0xc8>;
	hto-timeout = <0x50>;
	samsung,dw-mshc-ciu-div = <0x03>;
	clock-frequency = <0x2faf0800>;
	samsung,dw-mshc-sdr-timing = <0x03 0x00 0x02 0x01>;
	samsung,dw-mshc-ddr-timing = <0x03 0x00 0x02 0x01>;
	samsung,dw-mshc-sdr50-timing = <0x03 0x00 0x04 0x02>;
	samsung,dw-mshc-sdr104-timing = <0x03 0x00 0x03 0x00>;
	num-ref-clks = <0x09>;
	ciu_clkin = <0x19 0x32 0x32 0x19 0x32 0x64 0xc8 0x32 0x32>;
	clk-drive-number = <0x06>;
	pinctrl-names = "default", "fast-slew-rate-1x", "fast-slew-rate-1_5x", "fast-slew-rate-2x", "fast-slew-rate-2_5x", "fast-slew-rate-3x", "fast-slew-rate-4x", "pins-as-pdn", "pins-as-func";
	pinctrl-0 = <&sd2_clk &sd2_cmd &sd2_bus1 &sd2_bus4 &dwmmc2_cd_ext_irq>;
	pinctrl-1 = <&sd2_clk_fast_slew_rate_1x>;
	pinctrl-2 = <&sd2_clk_fast_slew_rate_1_5x>;
	pinctrl-3 = <&sd2_clk_fast_slew_rate_2x>;
	pinctrl-4 = <&sd2_clk_fast_slew_rate_2_5x>;
	pinctrl-5 = <&sd2_clk_fast_slew_rate_3x>;
	pinctrl-6 = <&sd2_clk_fast_slew_rate_4x>;
	pinctrl-7 = <&sd2_pins_as_pdn>;
	pinctrl-8 = <&sd2_clk &sd2_cmd &sd2_bus1 &sd2_bus4>;
	card-detect = <&gpa1 0x05 0x0f>;
	slot@0 {
		reg = <0x00>;
		bus-width = <0x04>;
		disable-wp;
	};
};

