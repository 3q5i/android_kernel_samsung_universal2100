/ {
	fragment@dit {
		target-path = "/";
		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			dit {
				compatible = "samsung,exynos-dit";
				status = "okay";
				interrupt-parent = <&gic>;
				interrupts = <0x00 0x22 0x04 0x00 0x23 0x04 0x00 0x24 0x04 0x00 0x25 0x04 0x00 0x21 0x04>;
				interrupt-names = "DIT-RxDst0", "DIT-RxDst1", "DIT-RxDst2", "DIT-Tx", "DIT-Err";
				reg = <0x00 0x1a570000 0x10000 0x00 0x1a420000 0x2000>;
				reg-names = "dit", "sysreg";
				dit_sharability_offset = <0x1028>;
				dit_sharability_value = <0x06>;
				dit_hw_version = <0x2010000>;
				dit_hw_capabilities = <0x00>;
				dit_use_tx = <0x00>;
				dit_use_rx = <0x01>;
				dit_use_clat = <0x00>;
				dit_hal_linked = <0x00>;
				dit_rx_extra_desc_ring_len = <0x800>;
				dit_irq_affinity = <0x02>;
			};
		};
	};
};

/ {
	fragment@camera {
		target-path = "/";
		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			interrupt-parent = <&gic>;
