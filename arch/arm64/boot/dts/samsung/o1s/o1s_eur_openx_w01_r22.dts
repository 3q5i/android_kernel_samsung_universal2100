&pinctrl_4 {
	smpl_warn: smpl-warn {
		samsung,pins = "gpg0-5";
		samsung,pin-function = <0x0f>;
		samsung,pin-pud = <0x00>;
		samsung,pin-drv = <0x00>;
		samsung,pin-con-pdn = <0x02>;
		samsung,pin-pud-pdn = <0x00>;
	};
	pm_wrstbi: pm-wrstbi {
		samsung,pins = "gpp14-1";
		samsung,pin-con-pdn = <0x03>;
		samsung,pin-pud-pdn = <0x00>;
	};
};

&acpm_mfd_bus0 {
	status = "okay";
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	s2mps23mfd@1f {
		compatible = "samsung,s2mps23mfd";
		acpm-ipc-channel = <0x02>;
		acpm-speedy-channel = <0x00>;
		s2mps23,wakeup = "enabled";
		reg = <0x1f>;
		interrupts = <0x00 0x02 0x04>;
		interrupt-parent = <&gic>;
		pinctrl-names = "default";
		pinctrl-0 = <&pm_wrstbi &smpl_warn>;
		gpios = <&gpg0 0x05 0x00>;
		wtsr_en = "enabled";
		smpl_en = "enabled";
		wtsr_timer_val = <0x03>;
		smpl_timer_val = <0x02>;
		sub_smpl_en = "enabled";
		check_jigon = <0x00>;
		init_time,sec = <0x00>;
		init_time,min = <0x00>;
		init_time,hour = <0x0c>;
		init_time,mday = <0x01>;
		init_time,mon = <0x00>;
		init_time,year = <0x78>;
		init_time,wday = <0x03>;
		smpl_warn_en = <0x01>;
		ocp_warn1_en = <0x00>;
		ocp_warn1_cnt = <0x00>;
		ocp_warn1_dvs_mask = <0x00>;
		ocp_warn1_lv = <0x00>;
		adc_mode = <0x01>;
		control_sel = <0x64 0x06 0x07 0x77 0x77 0x67 0x86 0x74 0x00 0x00 0x00 0x88 0x78 0x09 0x09 0x0f 0x00 0x00 0x00 0x00 0x60>;
		control_sel_evt0 = <0x64 0x06 0x07 0x77 0x77 0x67 0x76 0x64 0x00 0x00 0x70 0x88 0x98 0x99 0x09 0x0f 0x00 0x00 0x00 0x00 0x00>;
