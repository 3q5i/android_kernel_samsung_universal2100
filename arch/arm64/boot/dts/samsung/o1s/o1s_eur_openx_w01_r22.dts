&hsi2c_3 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	status = "okay";
	clock-frequency = <0x186a0>;
	mfc_charger: mfc-charger@3b {
		compatible = "idt,mfc-charger";
		reg = <0x3b>;
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&mfc_irq_default &wpc_det_default &wpc_en_default>;
		battery,wpc_int = <&gpa3 0x01 0x01>;
		battery,wpc_det = <&gpa2 0x00 0x00>;
		battery,wpc_en = <&gpb5 0x01 0x00>;
		battery,charger_name = "max77705-charger";
		battery,fuelgauge_name = "max77705-fuelgauge";
		battery,wireless_charger_name = "mfc-charger";
		battery,wc_cover_rpp = <0x44>;
		battery,phone_fod_threshold = <0x3b>;
		battery,wireless20_vout_list = <0x07 0x09 0x09>;
		battery,wireless20_vrect_list = <0x0a 0x0b 0x0b>;
		battery,wireless20_max_power_list = <0x02 0x03 0x03>;
		battery,oc_fod1 = <0x44c>;
		battery,tx_gear_min_op_freq_delay = <0xfa0>;
		battery,wpc_vout_ctrl_full = <0x0d>;
		fod_list {
			count = <0x01>;
			pad_0x00 {
				flag = <0x111>;
				cc = <0x96 0x40 0x8e 0x35 0x96 0x26 0x96 0x1c 0x9b 0x08 0x9c 0x05>;
				cv = <0x96 0x7f 0x8e 0x7f 0x96 0x76 0x96 0x6c 0x9b 0x58 0x9c 0x55>;
				full = <0xff 0x7f 0xff 0x7f 0xff 0x7f 0xff 0x7f 0xff 0x7f 0xff 0x7f>;
			};
		};
	};
};

&hsi2c_3 {
	samsung,stop-after-trans;
	samsung,stand-mode;
};

&pinctrl_2 {
	als_irq: als_irq-irq {
		samsung,pins = "gpa2-7";
		samsung,pin-function = <0x0f>;
		samsung,pin-pud = <0x00>;
