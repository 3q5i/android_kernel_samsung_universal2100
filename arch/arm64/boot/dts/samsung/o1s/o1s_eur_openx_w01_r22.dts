&pinctrl_1 {
	hsi2c39_bus_in: hsi2c39-bus-in {
		samsung,pins = "gpm1-0", "gpm1-1";
		samsung,pin-function = <0x00>;
		samsung,pin-pud = <0x01>;
		samsung,pin-drv = <0x00>;
	};
	hsi2c40_bus_in: hsi2c40-bus-in {
		samsung,pins = "gpm2-0", "gpm2-1";
		samsung,pin-function = <0x00>;
		samsung,pin-pud = <0x01>;
		samsung,pin-drv = <0x00>;
	};
	hsi2c41_bus_in: hsi2c41-bus-in {
		samsung,pins = "gpm3-0", "gpm3-1";
		samsung,pin-function = <0x00>;
		samsung,pin-pud = <0x00>;
		samsung,pin-drv = <0x00>;
	};
	hsi2c42_bus_in: hsi2c42-bus-in {
		samsung,pins = "gpm4-0", "gpm4-1";
		samsung,pin-function = <0x00>;
		samsung,pin-pud = <0x00>;
		samsung,pin-drv = <0x00>;
	};
	hsi2c43_bus_in: hsi2c43-bus-in {
		samsung,pins = "gpm5-0", "gpm5-1";
		samsung,pin-function = <0x00>;
		samsung,pin-pud = <0x00>;
		samsung,pin-drv = <0x00>;
	};
};

&pinctrl_4 {
	hsi2c7_bus_in: hsi2c7-bus-in {
		samsung,pins = "gpp3-2", "gpp3-3";
		samsung,pin-function = <0x00>;
		samsung,pin-pud = <0x00>;
		samsung,pin-drv = <0x00>;
	};
	hsi2c7_bus: hsi2c7-bus {
		samsung,pin-drv = <0x03>;
	};
	torch_init: torch_init {
		samsung,pins = "gpg0-4";
		samsung,pin-function = <0x01>;
		samsung,pin-con-pdn = <0x03>;
	};
	vt_reset_init: vt_reset_init {
		samsung,pins = "gpp13-0";
		samsung,pin-function = <0x01>;
		samsung,pin-con-pdn = <0x00>;
	};
};

&hsi2c_42 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	gpios = <&gpm4 0x00 0x00 &gpm4 0x01 0x00>;
	status = "okay";
	clock-frequency = <0xf4240>;
	samsung,reset-before-trans;
	samsung,fast-plus-mode;
	pinctrl-names = "default", "on_i2c", "off_i2c";
	pinctrl-0 = <&hsi2c42_bus_in>;
	pinctrl-1 = <&hsi2c42_bus>;
	pinctrl-2 = <&hsi2c42_bus_in>;
	is-2ld@10 {
		compatible = "samsung,exynos-is-cis-2ld";
		reg = <0x10>;
		id = <0x00>;
		setfile = "default";
		rev_reg = <0x02 0x02 0xa301>;
		vendor_use_adaptive_mipi;
	};
};

