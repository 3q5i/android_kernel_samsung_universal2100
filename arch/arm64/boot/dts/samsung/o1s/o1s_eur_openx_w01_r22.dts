		ssp-acc-position = <0x05>;
		ssp-mag-position = <0x04>;
		ssp-mag-array = [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00];
		ssp-thermi-up = [0c c5 0c a5 0c 7a 0c 48 0c 08 0b bb 0b 5b 0a f2 0a 71 09 dd 09 4a 08 a3 07 f4 07 44 06 93 05 e6 05 43 04 a8 04 16 03 94 03 1f 02 b4 02 53];
		ssp-thermi-sub = [0c b2 0c 96 0c 6f 0c 3f 0c 04 0b b8 0b 5d 0a f5 0a 7b 09 f5 09 60 08 bf 08 14 07 68 06 bc 06 14 05 73 04 da 04 4a 03 c9 03 54 02 e9 02 8f];
		gpio-controller;
		ssp-gps-pwr-en = <&gpp12 0x01 0x00>;
		ssp-host-req = <&gpa1 0x07 0x00>;
		ssp-mcu-req = <&gpb1 0x01 0x00>;
