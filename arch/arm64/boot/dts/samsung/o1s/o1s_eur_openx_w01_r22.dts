						battery1,v_empty = <0xa7e2>;
						battery1,v_empty_origin = <0x7d54>;
						battery1,capacity = <0xe2a>;
						battery1,fg_reset_wa_data = <0xe2a 0x3200 0x38a 0x2a 0x141f>;
						battery0,data_ver = <0x00>;
						battery1,data_ver = <0x00>;
						battery0,selected_reg = <0x02 0x7f80 0x12 0x2800 0x1e 0x746 0x21 0x6200 0x22 0x1600 0x2a 0x43c 0x2c 0xe3e1 0x2d 0x290e 0x2e 0x400 0x2f 0x01 0x32 0xd00 0x33 0xffff 0x37 0x5e0 0x42 0xa00 0xb4 0x7f80 0xb8 0x00 0xb9 0x6b 0xba 0x90c>;
						battery1,selected_reg = <0x02 0x7f80 0x12 0x2f00 0x1e 0x746 0x21 0x6200 0x22 0x1880 0x2a 0x43c 0x2c 0xe3e1 0x2d 0x290e 0x2e 0x400 0x2f 0x01 0x32 0xd00 0x33 0xffff 0x37 0x5e0 0x42 0xa80 0xb4 0x7f80 0xb8 0x00 0xb9 0x6b 0xba 0x90c>;
					};
				};
				sec-direct-charger {
					status = "okay";
					compatible = "samsung,sec-direct-charger";
					charger,battery_name = "battery";
					charger,main_charger = "max77705-charger";
					charger,direct_charger = "pca9468-charger";
					charger,dchg_min_current = <0x7d0>;
					charger,ta_alert_wa;
				};
				qbt2000 {
					compatible = "qcom,qbt2000";
					clocks = <&clock 0x6df &clock 0x6f1>;
					clock-names = "gate_spi_clk", "ipclk_spi";
					qcom,ipc-gpio = <&gpa1 0x03 0x00>;
					qcom,wuhb-gpio = <&gpa1 0x01 0x00>;
					qcom,btp-regulator = "VDD_BTP_1P8";
					qcom,position = "31.12,0.00,7.50,8.25,14.80,14.80,13.00,13.00,5.00";
					qcom,modelinfo = "G99X";
