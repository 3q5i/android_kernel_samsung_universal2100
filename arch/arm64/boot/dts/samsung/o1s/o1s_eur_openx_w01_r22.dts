		sec,irq_gpio = <&gpa1 0x00 0x00>;
		sec,project_name = "o1s", "m1s";
		sec,firmware_name = "y792_o1.bin";
		sec,bringup = <0x00>;
		sec,regulator_boot_on;
		sec,tclm_level = <0x02>;
		sec,afe_base = <0x115>;
		sec,area-size = <0x85 0x10a 0x155>;
		sec,max_coords = <0x1000 0x1000>;
		enable_settings_aot;
		support_fod;
		support_input_monitor;
		support_mis_calibration_test;
		support_ear_detect_mode;
		sync-reportrate-120;
		support_vrr;
		support_open_short_test;
		support_wireless_tx;
	};
};

&hsi2c_8 {
	pinctrl-names = "default";
	pinctrl-0 = <&tspi2c_bus>;
};

&pinctrl_4 {
	tspi2c_bus: tspi2c-bus {
