&hsi2c_19 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	status = "okay";
	clock-frequency = <0x61a80>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c19_amp_bus &spk_amp_int>;
	cs35l41_r: cs35l41@40 {
		#sound-dai-cells = <0x01>;
		compatible = "cirrus,cs35l41";
		reg = <0x40>;
		interrupt-parent = <&gpm16>;
		interrupts = <0x00 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&cs35l41_r_reset>;
		reset-gpios = <&gpb1 0x00 0x00>;
		VA-supply = <&l2_reg>;
		VP-supply = <&vbat>;
		cirrus,dsp-part-name = "cs35l40-bot";
		cirrus,right-channel-amp;
		cirrus,mfd-suffix = "_r";
		cirrus,bd-suffix = "_1";
		cirrus,use-fsync-errata;
		cirrus,bd-max-temp = <0x6e>;
		cirrus,asp-sdout-hiz = <0x03>;
		cirrus,dsp-noise-gate-enable;
		cirrus,dsp-noise-gate-delay = <0x04>;
		cirrus,dsp-noise-gate-threshold = <0x06>;
		cirrus,hw-noise-gate-select = <0x3f>;
		cirrus,hw-noise-gate-delay = <0x04>;
		cirrus,hw-noise-gate-threshold = <0x06>;
		cirrus,boost-peak-milliamp = <0x1004>;
		cirrus,classh-internal-algo {
			cirrus,classh-headroom = <0x0b>;
			cirrus,classh-release-rate = <0x04>;
			cirrus,classh-mem-depth = <0x05>;
			cirrus,classh-wk-fet-delay = <0x04>;
			cirrus,classh-wk-fet-thld = <0x01>;
		};
		cirrus,gpio-config2 {
			cirrus,gpio-src-select = <0x04>;
			cirrus,gpio-output-enable;
		};
		cirrus,pwr-params {
			cirrus,pwr-target-temp = <0xe74>;
			cirrus,pwr-exit-temp = <0xe10>;
		};
	};
	cs35l41_l: cs35l41@41 {
		#sound-dai-cells = <0x01>;
		compatible = "cirrus,cs35l41";
		reg = <0x41>;
		interrupt-parent = <&gpm16>;
		interrupts = <0x00 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&cs35l41_l_reset>;
		reset-gpios = <&gpb1 0x03 0x00>;
		VA-supply = <&l2_reg>;
		VP-supply = <&vbat>;
		cirrus,dsp-part-name = "cs35l40-rcv";
		cirrus,mfd-suffix = [00];
		cirrus,bd-suffix = "_0";
		cirrus,use-fsync-errata;
		cirrus,bd-max-temp = <0x64>;
		cirrus,asp-sdout-hiz = <0x03>;
		cirrus,dsp-noise-gate-enable;
		cirrus,dsp-noise-gate-delay = <0x04>;
		cirrus,dsp-noise-gate-threshold = <0x06>;
		cirrus,hw-noise-gate-select = <0x3f>;
		cirrus,hw-noise-gate-delay = <0x04>;
		cirrus,hw-noise-gate-threshold = <0x06>;
		cirrus,boost-peak-milliamp = <0x1004>;
		cirrus,classh-internal-algo {
			cirrus,classh-headroom = <0x0b>;
			cirrus,classh-release-rate = <0x04>;
			cirrus,classh-mem-depth = <0x05>;
			cirrus,classh-wk-fet-delay = <0x04>;
			cirrus,classh-wk-fet-thld = <0x01>;
		};
		cirrus,gpio-config2 {
			cirrus,gpio-src-select = <0x04>;
			cirrus,gpio-output-enable;
		};
		cirrus,pwr-params {
			cirrus,pwr-target-temp = <0xf3c>;
			cirrus,pwr-exit-temp = <0xed8>;
		};
	};
};

