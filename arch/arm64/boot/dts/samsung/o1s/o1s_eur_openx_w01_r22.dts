		als_rear,i2c_1p8-control;
		i2c_1p8-supply = <&l26_reg>;
		als_rear,gain_max = <0xbc>;
		als_rear,ir_spec = <0x00 0x4c4b40 0x00 0x4c4b40>;
		als_rear,clear_spec = <0x00 0x4c4b40 0x00 0x4c4b40>;
		als_rear,icratio_spec = <0x00 0x186a0 0x00 0x186a0>;
	};
};

