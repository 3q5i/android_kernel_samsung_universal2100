/ {
	fragment@model {
		target-path = "/";
		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			model = "Samsung O1S board based on EXYNOS2100";
			exynos_pm_dvs {
				compatible = "samsung,exynos-pm-dvs";
				vdd_lldo1 {
					vdd_lldo1-supply = <&b7_reg>;
					regulator_name = "vdd_lldo1";
					suspend_volt = <0xcf850>;
					init_volt = <0xcf850>;
					volt_range_step = <0xf424>;
				};
				vdd_lldo2 {
					vdd_lldo2-supply = <&b8_reg>;
					regulator_name = "vdd_lldo2";
					suspend_volt = <0xe7ef0>;
					init_volt = <0xf4240>;
					volt_range_step = <0xf424>;
				};
				vdd_mldo {
					vdd_mldo-supply = <&b9_reg>;
					regulator_name = "vdd_mldo";
					suspend_volt = <0x1c3a90>;
					init_volt = <0x1e8480>;
					volt_range_step = <0x30d4>;
				};
				vdd_lldo1s {
					vdd_lldo1s-supply = <&s_b7_reg>;
					regulator_name = "vdd_lldo1s";
					suspend_volt = <0x100590>;
					init_volt = <0x10c8e0>;
					volt_range_step = <0xf424>;
				};
				vdd_lldo2s {
					vdd_lldo2s-supply = <&s_b8_reg>;
					regulator_name = "vdd_lldo2s";
					suspend_volt = <0x1312d0>;
					init_volt = <0x149970>;
					volt_range_step = <0xf424>;
				};
			};
			sec_pm_debug {
				compatible = "samsung,sec-pm-debug";
				status = "okay";
			};
			sec_pm_log {
				compatible = "samsung,sec-pm-log";
				status = "okay";
			};
			secgpio_dvs {
				compatible = "samsung,exynos2100-secgpio-dvs";
				status = "okay";
			};
			sec_thermistor@0 {
				compatible = "samsung,sec-thermistor";
				status = "okay";
				thermistor_name = "sec-ap-thermistor";
				id = <0x00>;
				adc_array = <0x109 0x13b 0x174 0x1b5 0x207 0x264 0x2d1 0x34e 0x3dc 0x47e 0x534 0x5e8 0x6cd 0x7b2 0x89b 0x982 0xa6b 0xb3a 0xbfb 0xca6 0xd39 0xdb0 0xe1a>;
				temp_array = <0x384 0x352 0x320 0x2ee 0x2bc 0x28a 0x258 0x226 0x1f4 0x1c2 0x190 0x15e 0x12c 0xfa 0xc8 0x96 0x64 0x32 0x00 0xffffffce 0xffffff9c 0xffffff6a 0xffffff38>;
				io-channels = <&s2mps23_gpadc 0x00>;
				io-channel-names = "adc-ap-temp";
				io-channel-ranges;
			};
			sec_thermistor@2 {
				compatible = "samsung,sec-thermistor";
				status = "okay";
				thermistor_name = "sec-wf-thermistor";
				id = <0x01>;
				adc_array = <0x10e 0x140 0x179 0x1bb 0x20c 0x26a 0x2d6 0x353 0x3e2 0x483 0x539 0x5f7 0x6d3 0x7b6 0x89e 0x986 0xa6c 0xb3e 0xbfc 0xca6 0xd39 0xdb1 0xe17>;
				temp_array = <0x384 0x352 0x320 0x2ee 0x2bc 0x28a 0x258 0x226 0x1f4 0x1c2 0x190 0x15e 0x12c 0xfa 0xc8 0x96 0x64 0x32 0x00 0xffffffce 0xffffff9c 0xffffff6a 0xffffff38>;
				io-channels = <&s2mps23_gpadc 0x02>;
				io-channel-names = "adc-wf-temp";
				io-channel-ranges;
			};
			sec_thermistor@6 {
				compatible = "samsung,sec-thermistor";
				status = "okay";
				thermistor_name = "sec-nr-thermistor";
				id = <0x02>;
				adc_array = <0x16d 0x1db 0x25a 0x2f6 0x3ac 0x477 0x552 0x640 0x732 0x822 0x90d 0x9ee 0xab1 0xb69 0xc0d 0xc9d 0xd1a 0xd88 0xde2 0xe36 0xe77 0xeb0 0xee2>;
				temp_array = <0xffffff38 0xffffff6a 0xffffff9c 0xffffffce 0x00 0x32 0x64 0x96 0xc8 0xfa 0x12c 0x15e 0x190 0x1c2 0x1f4 0x226 0x258 0x28a 0x2bc 0x2ee 0x320 0x352 0x384>;
				io-channels = <&s2mps23_gpadc 0x06>;
				io-channel-names = "adc-nr-temp";
				io-channel-ranges;
			};
			sec_thermistor@7 {
				compatible = "samsung,sec-thermistor";
				status = "okay";
				thermistor_name = "sec-lte-thermistor";
				id = <0x03>;
				adc_array = <0x16f 0x1dd 0x25d 0x2f9 0x3af 0x47b 0x556 0x644 0x736 0x825 0x910 0x9f1 0xab4 0xb6b 0xc0f 0xc9f 0xd1d 0xd88 0xde4 0xe37 0xe77 0xeb1 0xee2>;
				temp_array = <0xffffff38 0xffffff6a 0xffffff9c 0xffffffce 0x00 0x32 0x64 0x96 0xc8 0xfa 0x12c 0x15e 0x190 0x1c2 0x1f4 0x226 0x258 0x28a 0x2bc 0x2ee 0x320 0x352 0x384>;
				io-channels = <&s2mps23_gpadc 0x07>;
				io-channel-names = "adc-lte-temp";
				io-channel-ranges;
			};
			sec_thermistor@11 {
				compatible = "samsung,sec-thermistor";
				status = "okay";
				thermistor_name = "sec-flash-thermistor";
				id = <0x04>;
				adc_array = <0x11b 0x14e 0x187 0x1cb 0x21d 0x27c 0x2e9 0x368 0x3f7 0x49c 0x553 0x617 0x6ef 0x7d3 0x8b9 0x9a1 0xa85 0xb52 0xc0f 0xcb7 0xd4a 0xdba 0xe20>;
				temp_array = <0x384 0x352 0x320 0x2ee 0x2bc 0x28a 0x258 0x226 0x1f4 0x1c2 0x190 0x15e 0x12c 0xfa 0xc8 0x96 0x64 0x32 0x00 0xffffffce 0xffffff9c 0xffffff6a 0xffffff38>;
				io-channels = <&s2mps23_gpadc 0x0b>;
				io-channel-names = "adc-flash-temp";
				io-channel-ranges;
			};
			fixed-rate-clocks {
				oscclk {
					compatible = "samsung,exynos2100-oscclk";
					clock-frequency = <0x18cba80>;
				};
			};
			firmware {
				android: android {
					compatible = "android,firmware";
					vbmeta {
						compatible = "android,vbmeta";
						parts = "vbmeta,boot,vendor_boot,system,vendor,product,odm,prism,optics,vbmeta_system,recovery,dtbo,keystorage,harx";
					};
				};
			};
			gpio_keys {
				status = "okay";
				compatible = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&key_voldown &key_volup>;
				button@2 {
					label = "gpio-keys: KEY_VOLUMEDOWN";
					linux,code = <0x72>;
					gpios = <&gpa0 0x04 0x0f>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
				};
				button@3 {
					label = "gpio-keys: KEY_VOLUMEUP";
					linux,code = <0x73>;
					gpios = <&gpa0 0x03 0x0f>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
				};
			};
			exynos_rgt {
				compatible = "samsung,exynos-rgt";
				num-acpm-pmic = <0x02>;
				last-supply = <&_ldo18_reg>;
			};
			sec-reboot {
				compatible = "samsung,sec-reboot";
				samsung,syscon-phandle = <&pmu_system_controller>;
				shutdown-offset = <0x30c>;
				shutdown-trigger = <0x100>;
				magic-inform = <0x808>;
				panic-inform = <0x80c>;
			};
			sec-param {
				compatible = "samsung,sec-param";
				char-table-size = <0x03>;
				char-offset-table = <0x700230 0x04 0x700264 0x04 0x700254 0x01>;
				u32-table-size = <0x01>;
				u32-offset-table = <0x700258>;
			};
			usb_hs_tune: hs_tune {
				hs_tune_cnt = <0x07>;
				hs_tune1 {
					tune_name = "tx_pre_emp";
					tune_value = <0x02 0x02>;
