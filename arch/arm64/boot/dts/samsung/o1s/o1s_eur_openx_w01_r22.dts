				sbi_ap_llc_return_mask = <0x0f>;
				sbi_ap_llc_return_pos = <0x09>;
				sbi_ap_llc_alloc_mask = <0x01>;
				sbi_ap_llc_alloc_pos = <0x08>;
				sbi_ap_llc_way_mask = <0xff>;
				sbi_ap_llc_way_pos = <0x00>;
				sbi_cp_llc_return_mask = <0x0f>;
				sbi_cp_llc_return_pos = <0x09>;
				sbi_cp_llc_alloc_mask = <0x01>;
				sbi_cp_llc_alloc_pos = <0x08>;
				sbi_cp_llc_way_mask = <0xff>;
				sbi_cp_llc_way_pos = <0x00>;
				cp_btl_node_name = "ramdump_memshare";
				pktproc_support = <0x01>;
				pktproc_version = <0x02>;
				pktproc_cp_base = <0x50800000>;
				pktproc_info_rgn_offset = <0x00>;
				pktproc_info_rgn_size = <0x100>;
				pktproc_desc_rgn_offset = <0x100>;
				pktproc_desc_rgn_size = <0xfff00>;
				pktproc_buff_rgn_offset = <0x100000>;
				pktproc_info_desc_rgn_cached = <0x00>;
				pktproc_buff_rgn_cached = <0x00>;
				pktproc_desc_mode = <0x01>;
				pktproc_num_queue = <0x01>;
				pktproc_use_exclusive_irq = <0x01>;
				pktproc_exclusive_irq_idx = <0x01 0x02 0x03 0x04>;
				pktproc_use_buff_mng = <0x00>;
				pktproc_desc_num_ratio_percent = <0x32>;
