			button@1 {
				label = "pmic-keys: KEY_POWER";
				linux,code = <0x74>;
				wakeup = <0x01>;
			};
		};
		regulators {
			b1_reg: BUCK1 {
				regulator-name = "vdd_g3d";
				regulator-min-microvolt = <0x6ddd0>;
				regulator-max-microvolt = <0x13d620>;
				regulator-always-on;
				regulator-ramp-delay = <0x1770>;
				regulator-initial-mode = <0x01>;
			};
			b4_reg: BUCK4 {
				regulator-name = "vdd_int";
