			wlan {
				compatible = "samsung,brcm-wlan";
				gpios = <&gpp12 0x02 0x01 &gpa0 0x07 0x01>;
				pinctrl-names = "default";
				pinctrl-0 = <&cfg_wlanen &wlan_host_wake>;
				status = "okay";
