								resource,value = <0x00 0x00>;
							};
							resource@5 {
								resource,label = "int";
								resource,value = <0x00 0x00>;
							};
						};
					};
					booster_key@9 {
						input_booster,label = "pen";
						input_booster,type = <0x08>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x258>;
						inputbooster,resource {
							compatible = "resource";
							resource@1 {
								resource,label = "cluster2";
								resource,value = <0x196400 0xfde80>;
							};
							resource@4 {
								resource,label = "mif";
								resource,value = <0xf78f0 0xf78f0>;
							};
							resource@5 {
								resource,label = "bimc";
								resource,value = <0x00 0x00>;
							};
						};
					};
				};
				kq-balancer {
					compatible = "samsung,kq-balancer";
					status = "okay";
					timeout = <0x190>;
					cpu {
						cl0 {
							cpu,name = "cpu-lit";
							cpu,base = <0x00>;
							cpu,qos_delay = <0x09>;
						};
						cl1 {
							cpu,name = "cpu-mid";
							cpu,base = <0x04>;
							cpu,qos_delay = <0x08>;
						};
						cl2 {
							cpu,name = "cpu-big";
							cpu,base = <0x07>;
							cpu,qos_delay = <0x07>;
						};
					};
					dev {
						devmif {
							dev,name = "dev-mif";
							dev,base = <0x01>;
							dev,qos_delay = <0x0a>;
							dev,size = <0x0d>;
							dev,table = <0x3066a0 0x29a810 0x26ae58 0x22e980 0x1ef1e0 0x1a2f20 0x177bb8 0x14a140 0xf78f0 0xce4c8 0xa50a0 0x854d0 0x66c88>;
						};
					};
				};
				hall_ic: hall_ic {
					status = "okay";
					compatible = "hall_ic";
					pinctrl-names = "default";
					pinctrl-0 = <&hall_irq &certify_hall_irq>;
					hall: hall {
						event = <0x15>;
						gpios = <&gpa3 0x06 0x01>;
					};
					certify_hall: certify_hall {
						event = <0x1b>;
						gpios = <&gpa0 0x02 0x01>;
					};
				};
				pwm_config_0 {
					compatible = "samsung,pwm_pinctrl";
					pinctrl-names = "default";
					pinctrl-0 = <&sec_pwm_pinctrl_0>;
					status = "ok";
				};
				sec_abc {
					compatible = "samsung,sec_abc";
					status = "okay";
					gpu {
						gpu,label = "GPU fault";
						gpu,threshold_count = <0x14>;
						gpu,threshold_time = <0x4b0>;
					};
					aicl {
						aicl,label = "battery aicl";
						aicl,threshold_count = <0x05>;
						aicl,threshold_time = <0x12c>;
					};
					motto {
						motto,label = "motto info base";
