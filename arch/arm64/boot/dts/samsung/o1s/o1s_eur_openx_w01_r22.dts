				pktproc_ul_desc_rgn_size = <0xfff00>;
				pktproc_ul_buff_rgn_offset = <0x100000>;
				pktproc_ul_padding_required = <0x01>;
				pktproc_ul_num_queue = <0x02>;
				pktproc_ul_max_packet_size = <0x800>;
				pktproc_ul_info_desc_rgn_cached = <0x00>;
				pktproc_ul_buff_rgn_cached = <0x00>;
				pktproc_ul_use_hw_iocc = <0x00>;
				devfreq_use_dfs_max_freq = <0x01>;
				devfreq_cal_id_mif = <0xb040000>;
				cpif_tpmon {
					tpmon_trigger_mbps = <0x1e>;
					tpmon_trigger_msec_min = <0x64>;
					tpmon_trigger_msec_max = <0x1f4>;
					tpmon_monitor_interval_msec = <0x64>;
					tpmon_monitor_hold_msec = <0xbb8>;
					tpmon_monitor_stop_mbps = <0x0f>;
					tpmon_boost_hold_msec = <0x1770>;
					tpmon_unboost_tp_percent = <0x28>;
					tpmon_rps_q {
						tpmon,enable = <0x00>;
						tpmon,name = "RPS_Q";
						tpmon,measure = <0x01>;
						tpmon,target = <0x00>;
						tpmon,idx = <0x00>;
						tpmon,threshold = <0xbb8>;
						tpmon,values = <0x00 0x30>;
					};
					tpmon_rps_tp {
						tpmon,enable = <0x01>;
						tpmon,name = "RPS_TP";
						tpmon,measure = <0x00>;
						tpmon,target = <0x00>;
						tpmon,idx = <0x00>;
						tpmon,threshold = <0x12c>;
						tpmon,values = <0x00 0x30>;
					};
					tpmon_gro_flush_time {
						tpmon,enable = <0x01>;
						tpmon,name = "GRO";
						tpmon,measure = <0x00>;
						tpmon,target = <0x01>;
						tpmon,idx = <0x00>;
						tpmon,threshold = <0x1e 0x64 0xc8>;
						tpmon,values = <0x00 0x2710 0xc350 0x186a0>;
					};
					tpmon_mif {
						tpmon,enable = <0x01>;
						tpmon,name = "MIF";
						tpmon,measure = <0x00>;
						tpmon,target = <0x02>;
						tpmon,idx = <0x00>;
						tpmon,threshold = <0x2bc>;
						tpmon,values = <0x00 0xf78f0>;
						tpmon,check_udp = <0x01>;
					};
					tpmon_cpu_cl0 {
						tpmon,enable = <0x01>;
						tpmon,name = "CL0";
						tpmon,measure = <0x00>;
						tpmon,target = <0x09>;
						tpmon,idx = <0x00>;
						tpmon,threshold = <0x64 0x12c>;
						tpmon,values = <0x00 0x104410 0x137090>;
						tpmon,check_udp = <0x01>;
					};
					tpmon_cpu_cl1 {
						tpmon,enable = <0x01>;
						tpmon,name = "CL1";
						tpmon,measure = <0x00>;
						tpmon,target = <0x0a>;
						tpmon,idx = <0x04>;
						tpmon,threshold = <0x1f4 0x2bc 0x5dc>;
						tpmon,values = <0x00 0xcb200 0x130b00 0x17cdc0>;
						tpmon,check_udp = <0x01>;
					};
					tpmon_irq_affinity_dit_pktproc_q {
						tpmon,enable = <0x01>;
						tpmon,name = "IRQ_DIT_PKTPROC_Q";
						tpmon,measure = <0x02>;
						tpmon,target = <0x06>;
						tpmon,idx = <0x00>;
						tpmon,threshold = <0x1770>;
						tpmon,values = <0x02 0x06>;
						tpmon,urgent = <0x01>;
					};
					tpmon_irq_affinity_dit_q {
						tpmon,enable = <0x01>;
						tpmon,name = "IRQ_DIT_Q";
						tpmon,measure = <0x03>;
						tpmon,target = <0x06>;
						tpmon,idx = <0x00>;
						tpmon,threshold = <0x1b58>;
						tpmon,values = <0x02 0x06>;
