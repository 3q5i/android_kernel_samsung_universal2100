				compatible = "samsung,audio-sysfs";
				status = "okay";
				audio,no-earjack;
				audio,num-amp = <0x02>;
			};
			sec-audio-debug {
				compatible = "samsung,audio-debug";
				status = "okay";
			};
			pinctrl@14EC0000 {
				bt_hostwake: bt-hostwake {
					samsung,pins = "gpa2-3";
					samsung,pin-function = <0x0f>;
					samsung,pin-pud = <0x01>;
				};
			};
			pinctrl@10430000 {
				bt_btwake: bt-btwake {
					samsung,pins = "gpp14-0";
					samsung,pin-function = <0x01>;
					samsung,pin-pud = <0x00>;
					samsung,pin-con-pdn = <0x03>;
					samsung,pin-pud-pdn = <0x00>;
				};
			};
			pinctrl@14E30000 {
				bt_en: bt-en {
					samsung,pins = "gpm8-0";
					samsung,pin-function = <0x01>;
					samsung,pin-pud = <0x00>;
					samsung,pin-con-pdn = <0x03>;
					samsung,pin-pud-pdn = <0x00>;
				};
			};
			bluetooth {
				compatible = "samsung,bcm43xx";
				gpios = <&gpm8 0x00 0x00 &gpp14 0x00 0x00 &gpa2 0x03 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&bt_en &bt_btwake &bt_hostwake>;
				status = "okay";
			};
		};
	};
};

&pinctrl_4 {
	sub_pmic_irq: sub-pmic-irq {
		samsung,pins = "gpp14-2";
		samsung,pin-function = <0x00>;
		samsung,pin-pud = <0x00>;
		samsung,pin-drv = <0x00>;
		samsung,pin-con-pdn = <0x02>;
		samsung,pin-pud-pdn = <0x00>;
	};
};

&hsi2c_38 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	status = "okay";
	s2mpb02_pmic@59 {
		compatible = "s2mpb02,s2mpb02mfd";
		reg = <0x59>;
		s2mpb02,wakeup;
		pinctrl-names = "default";
		pinctrl-0 = <&sub_pmic_irq>;
		regulators {
			_buck1_reg: s2mpb02-buck1 {
				regulator-name = "VDDD_1.05V_CAM";
				regulator-min-microvolt = <0x13d620>;
				regulator-max-microvolt = <0x13d620>;
			};
			_buck2_reg: s2mpb02-buck2 {
				regulator-name = "S2MPB02_BUCK2";
				regulator-min-microvolt = <0x13d620>;
				regulator-max-microvolt = <0x13d620>;
			};
			_buckboost_reg: s2mpb02-bb {
				regulator-name = "S2MPB02_BB";
				regulator-min-microvolt = <0x27ac40>;
				regulator-max-microvolt = "", "=\t";
				regulator-always-on;
				regulator-boot-on;
			};
			_ldo1_reg: s2mpb02-ldo1 {
				regulator-name = "VDDPHY_1.05V_CAM";
				regulator-min-microvolt = <0x100590>;
				regulator-max-microvolt = <0x100590>;
			};
			_ldo2_reg: s2mpb02-ldo2 {
				regulator-name = "S2MPB02_LDO2";
				regulator-min-microvolt = <0xf4240>;
				regulator-max-microvolt = <0xf4240>;
			};
			_ldo3_reg: s2mpb02-ldo3 {
				regulator-name = "VDDD_1.05V_SUB";
				regulator-min-microvolt = <0x100590>;
				regulator-max-microvolt = <0x100590>;
			};
			_ldo4_reg: s2mpb02-ldo4 {
				regulator-name = "VDDD_1.1V_WIDESUB";
				regulator-min-microvolt = <0x10c8e0>;
				regulator-max-microvolt = <0x10c8e0>;
			};
			_ldo5_reg: s2mpb02-ldo5 {
				regulator-name = "VDDD_1.05V_VT";
				regulator-min-microvolt = <0x100590>;
				regulator-max-microvolt = <0x100590>;
			};
			_ldo6_reg: s2mpb02-ldo6 {
				regulator-name = "VDDIO_1.8V_SUB";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
			};
			_ldo7_reg: s2mpb02-ldo7 {
				regulator-name = "VDDIO_1.8V_CAM";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
			};
			_ldo8_reg: s2mpb02-ldo8 {
				regulator-name = "VDDA_1.8V_WIDESUB";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
			};
			_ldo9_reg: s2mpb02-ldo9 {
				regulator-name = "VDDIO_1.8V_VT";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
			};
			_ldo10_reg: s2mpb02-ldo10 {
