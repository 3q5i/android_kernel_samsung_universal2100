	als_irqsleep: als_irqsleep {
		samsung,pins = "gpa2-7";
		samsung,pin-function = <0x00>;
		samsung,pin-pud = <0x00>;
	};
	als_irqidle: als_irqidle {
		samsung,pins = "gpa2-7";
		samsung,pin-function = <0x0f>;
		samsung,pin-pud = <0x00>;
	};
};

&hsi2c_6 {
	status = "okay";
	clock-frequency = <0x61a80>;
	als_rear@29 {
		compatible = "ams,tsl2510";
		reg = <0x29>;
		pinctrl-names = "default", "sleep", "idle";
		pinctrl-0 = <&als_irq>;
