						motto,info_device_base = <0x1586085c>;
					};
				};
				abc_hub {
					compatible = "samsung,abc_hub";
					status = "okay";
					pinctrl-0 = <&sub_detect_conn_setting &sub_detect_conn_setting2 &cam_detect_conn_setting>;
