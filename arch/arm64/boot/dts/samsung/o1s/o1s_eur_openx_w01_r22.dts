		ssp-sns-combination = <0x00>;
		ssp-glass-type = <0x00>;
		ssp-mag-type = <0x01>;
		ssp-vdd-mcu-1p8 = "vdd_mcu_1p8";
		controller-data {
			cs-gpio = <&gpp7 0x03 0x00>;
			samsung,spi-feedback-delay = <0x00>;
		};
	};
};

