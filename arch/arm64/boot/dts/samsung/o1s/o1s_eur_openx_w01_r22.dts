/dts-v1/;
/plugin/;

/ {
	compatible = "SAMSUNG,O1S_EUR_OPENX", "SAMSUNG,EXYNOS2100";
	board_id = <0x01>;
	board_rev = <0x00>;
	edtbo-rev = <0x00>;
	dtbo-hw_rev = <0x16>;
	dtbo-hw_rev_end = <0x20>;
};

/ {
	fragment@smd {
		target-path = "/";
		__overlay__ {
			smd: samsung_mobile_device {
				compatible = "simple-bus";
				max77705_charger: max77705-charger {
					charger,fac_vsys = <0xed8>;
					charger,enable_sysovlo_irq;
					charger,fsw = <0x00>;
				};
				sec_battery: battery {
					battery,fgsrc_switch_name = "max77705-charger";
					battery,otg_name = "max77705-otg";
					status = "okay";
					compatible = "samsung,sec-battery";
					battery,vendor = "Battery";
					battery,charger_name = "sec-direct-charger";
					battery,fuelgauge_name = "max77705-fuelgauge";
					battery,technology = <0x02>;
					battery,chip_vendor = "LSI";
